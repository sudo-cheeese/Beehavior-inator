 color: purple;">Singles</th>\n                                   <th style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;">Boybands</th>\n                                   <th style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;">Girl Groups</th>\n                              </tr>\n                              </thead>\n                              <!--data/songs that fit in with the titles-->\n                              <tbody>\n                                   <tr>\n                                        <!-- first td is for singles, 2nd is for boybands, and third is girl groups-->\n                                        <td style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;"><a href="https://www.youtube.com/watch?v=YFood_bTOX4" target="_blank">How am I supposed to live without you by Michael Bolton</a></td>\n                                        <td style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;"><a href="https://www.youtube.com/watch?v=4fndeDfaWCg" target="_blank">I Want it that Way by Backstreet Boys</a></td>\n                                        <td style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;"><a href="https://www.youtube.com/watch?v=tscL_I2v7pU" target="_blank">Wannabe by Spice Girls</a></td>\n                                   </tr>\n                                   <tr>\n                                        <td style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;"><a href="https://www.youtube.com/watch?v=xweiQukBM_k" target="_blank">Opposites Attract by Paula Abdul</a></td>\n                                        <td style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;"><a href="https://www.youtube.com/watch?v=_ZcmuKsyvzg" target="_blank">Tearin up my Heart by NSYNC</a></td>\n                                        <td style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;"><a href="https://www.youtube.com/watch?v=nPXqkjpXZ_k" target="_blank">Never Ever by All Saints</a></td>\n                                   </tr>\n                                   <tr>\n                                        <td style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;"><a href="https://www.youtube.com/watch?v=Xc1uQI2XmZs" target="_blank">Because I Love You by Stevie B</a></td>\n                                        <td style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;"><a href="https://www.youtube.com/watch?v=N2ICtCO8TCw" target="_blank">Back for Good by Take That</a></td>\n                                        <td style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;"><a href="https://www.youtube.com/watch?v=FrLequ6dUdM" target="_blank">No Scrubs by TLC</a></td>\n                                   </tr>\n                                   <tr>\n                                        <td style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;"><a href="https://www.youtube.com/watch?v=LaTGrV58wec" target="_blank"> Gonna Make You Sweat by C+C Music Factory</a></td>\n                                        <td style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;"><a href="https://www.youtube.com/watch?v=FbWJVult-9M" target="_blank">Keep on Movin\' by Five</a></td>\n                                        <td style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;"><a href="https://www.youtube.com/watch?v=VaXyWnso53k" target="_blank">I\'m so into you by SWV</a></td>\n                                   </tr>\n                                   <tr>\n                                        <td style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;"><a href="https://www.youtube.com/watch?v=rog8ou-ZepE" target="_blank">Ice Ice Baby by Vanilla Ice</a></td>\n                                        <td style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;"><a href="https://www.youtube.com/watch?v=CA-aneBpSEQ" target="_blank">I swear by All 4 One</a></td>\n                                        <td style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;"><a href="https://www.youtube.com/watch?v=sQgd6MccwZc" target="_blank">Say My Name by Destiny\'s Child</a></td>\n                                   </tr>\n                                   <tr>\n                                        <td style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;"><a href="https://www.youtube.com/watch?v=Y0pdQU87dc8" target="_blank">(Everything I Do) I Do It for You by Bryan Adams</a></td>\n                                        <td style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;"><a href="https://www.youtube.com/watch?v=NHuGG_FsC20" target="_blank">Summer Girls by LFO</a></td>\n                                        <td style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;"><a href="https://www.youtube.com/watch?v=3lO5eGEnyRA" target="_blank">Where My Girls At by 702</a></td>\n                                   </tr>\n                                   <tr>\n                                        <td style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;"><a href="https://www.youtube.com/watch?v=F2AitTPI5U0" target="_blank">Black Or White by Michael Jackson</a></td>\n                                        <td style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;"><a href="https://www.youtube.com/watch?v=hx-ijRMl1D4" target="_blank">Motownphilly by Boyz II Men</a></td>\n                                        <td style=" border: solid pink 2px; background-color: white; padding: 20px; color: purple;"><a href="https://www.youtube.com/watch?v=1bzEYg-CpQE" target="_blank">If you Love me by Brownstone</a></td>\n                                   </tr>\n                              </tbody>\n                         </table>\n                         <marquee scrollamount="30"><iframe src="https://www.youtube.com/embed/26nsBfLXwSQ?autoplay=1&loop=1" frameborder="0" width="50px" height="50px" loop></iframe></marquee>\n                    </div>\n               </span>\n          </section>\n     </body>\n</html>\n'

